ey', 'sector_key', 'unit_key', 'source_key']) }} as fact_investment_by_sector_key,\r\n\r\n        time_key,\r\n        sector_key,\r\n        unit_key,\r\n        source_key,\r\n\r\n        cast(round(investment_value, 3) as decimal(38,3)) as investment_value,\r\n\r\n        cast(\r\n            round(investment_value_pre_year, 3)\r\n            as decimal(38,3)\r\n        ) as investment_value_pre_year,\r\n\r\n        {{ sk(['time_key', 'sector_key', 'unit_key', 'source_key']) }} as load_id,\r\n        current_timestamp() as created_at,\r\n        ingest_at\r\n\r\n    from joined\r\n\r\n)\r\n\r\nselect *\r\nfrom final", "doc_blocks": [], "language": "sql", "refs": [{"name": "stg_investment_by_sector", "package": null, "version": null}, {"name": "dim_time", "package": null, "version": null}, {"name": "dim_sector", "package": null, "version": null}, {"name": "dim_unit", "package": null, "version": null}, {"name": "dim_source", "package": null, "version": null}], "sources": [], "metrics": [], "functions": [], "depends_on": {"macros": ["macro.Vietnam_economic_lakehouse.sk"], "nodes": ["model.Vietnam_economic_lakehouse.stg_investment_by_sector", "model.Vietnam_economic_lakehouse.dim_time", "model.Vietnam_economic_lakehouse.dim_sector", "model.Vietnam_economic_lakehouse.dim_unit", "model.Vietnam_economic_lakehouse.dim_source"]}, "compiled_path": null, "contract": {"enforced": false, "alias_types": true, "checksum": null}, "access": "protected", "constraints": [], "version": null, "latest_version": null, "deprecation_date": null, "primary_key": ["fact_investment_by_sector_key"], "time_spine": null}, "model.Vietnam_economic_lakehouse.dim_source": {"database": null, "schema": "gold_gold", "name": "dim_source", "resource_type": "model", "package_name": "Vietnam_economic_lakehouse", "path": "dimensions/dim_source.sql", "original_file_path": "models/dimensions/dim_source.sql", "unique_id": "model.Vietnam_economic_lakehouse.dim_source", "fqn": ["Vietnam_economic_lakehouse", "di