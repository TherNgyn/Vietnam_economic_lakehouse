_value / nullif(total_investment_value, 0)\n * 100 as investment_share_pct\nfrom calc", "relation_name": "gold_marts.mart_investment_metrics", "batch_results": null, "overload_results": null}], "elapsed_time": 3.750786304473877, "args": {"require_explicit_package_overrides_for_builtin_materializations": true, "static_parser": true, "log_path": "/opt/airflow/dbt/logs", "invocation_command": "dbt run --select mart_investment_metrics", "require_source_and_semantic_model_names_without_spaces": false, "populate_cache": true, "validate_macro_args": false, "use_colors": true, "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "require_batched_execution_for_custom_microbatch_strategy": false, "log_level": "info", "state_modified_compare_more_unrendered_values": false, "macro_debugging": false, "defer": false, "log_file_max_bytes": 10485760, "profiles_dir": "/opt/airflow/dbt", "show_all_deprecations": false, "enable_grouped_warn_error_parser_logs": false, "require_nested_cumulative_type_params": false, "show_resource_report": false, "require_generic_test_arguments_property": true, "favor_state": false, "cache_selected_only": false, "log_format": "default", "latest_version_pointer_enabled_by_default": false, "use_fast_test_edges": false, "print": true, "which": "run", "write_json": true, "project_dir": "/opt/airflow/dbt", "partial_parse_file_diff": true, "require_yaml_configuration_for_mf_time_spines": false, "require_sql_header_in_test_configs": false, "log_format_file": "debug", "upload_to_artifacts_ingest_api": false, "manage_state": false, "use_v2_parser": false, "strict_mode": false, "source_freshness_run_project_hooks": true, "require_all_warnings_handled_by_warn_error": false, "printer_width": 80, "maximum_seed_size_mib": 1, "send_anonymous_usage_stats": true, "quiet": false, "allow_jinja_file_extensions": false, "indirect_selection": "eager", "vars": {}, "require_ref_searches_node_package_before_root": false, "introspect": true, "require_unique_pro