[0m17:05:13.900372 [debug] [Thread-2 (]: On model.Vietnam_economic_lakehouse.dim_unit_type: /* {"app": "dbt", "dbt_version": "1.12.0b3", "profile_name": "Vietnam_economic_lakehouse", "target_name": "spark", "node_id": "model.Vietnam_economic_lakehouse.dim_unit_type"} */
create or replace view gold_gold.dim_unit_type
  
  
  as
    

select 1 as unit_type_key, 'CURRENCY' as unit_type_name
union all select 2, 'PERCENTAGE'
union all select 3, 'INDEX'
union all select 4, 'QUANTITY'
union all select 5, 'AREA'
union all select 6, 'PRICE'
union all select 99, 'UNKNOWN'

