[0m17:05:13.275973 [debug] [Thread-1 (]: On model.Vietnam_economic_lakehouse.dim_sector: /* {"app": "dbt", "dbt_version": "1.12.0b3", "profile_name": "Vietnam_economic_lakehouse", "target_name": "spark", "node_id": "model.Vietnam_economic_lakehouse.dim_sector"} */

  
    
        create or replace table gold_gold.dim_sector
      
      
    using delta
      
      
      
      
      
      

      as
      

with sectors as (
    select distinct sector_name from gold_staging.stg_gdp
    union
    select distinct sector_name from gold_staging.stg_investment
)

select
    
    abs(xxhash64(coalesce(cast(sector_name as string), '__null__')))
 as sector_key,
    sector_name
from sectors
where sector_name is not null
  
