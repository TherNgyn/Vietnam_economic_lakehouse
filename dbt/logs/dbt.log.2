[0m17:27:59.068279 [debug] [Thread-1 (]: On model.Vietnam_economic_lakehouse.dim_asset: /* {"app": "dbt", "dbt_version": "1.12.0b3", "profile_name": "Vietnam_economic_lakehouse", "target_name": "spark", "node_id": "model.Vietnam_economic_lakehouse.dim_asset"} */
create or replace view gold_gold.dim_asset
  
  
  as
    


with assets as (
    select distinct
        symbol,
        asset_name,
        asset_class_name,
        market_name,
        country
    from gold_staging.stg_ohlc

    union

    select distinct
        symbol,
        asset_name,
        asset_class_name,
        market_name,
        country
    from gold_staging.stg_interest_rate
)

select
    
    abs(xxhash64(coalesce(cast(a.symbol as string), '__null__'), coalesce(cast(a.asset_class_name as string), '__null__'), coalesce(cast(a.market_name as string), '__null__')))
 as asset_key,
    a.symbol,
    a.asset_name,
    ac.asset_class_key,
    m.market_key
from assets a
left join gold_gold.dim_asset_class ac
    on a.asset_class_name = ac.asset_class_name
left join gold_gold.dim_market m
    on a.market_name = m.market_name
   and coalesce(a.country, '__null__') = coalesce(m.country, '__null__')
where a.symbol is not null

