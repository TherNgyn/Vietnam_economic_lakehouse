        CREATE TABLE gold_gold.fact_production_output
        USING DELTA
        AS
        

with base as (

    select
        cast(to_date(report_date) as date) as report_date,

        cast(year(to_date(report_date)) as int) as report_year,
        cast(quarter(to_date(report_date)) as int) as report_quarter,
        cast(month(to_date(report_date)) as int) as report_month,

        product_name,
        product_category_name,

        cast(value as decimal(38,10)) as value,
        unit_name as unit,

        period_grain,
        ingest_at

    from gold_staging.stg_production_output
),

joined as (

    select
        cast(dt.time_key as int) as time_key,

        p.product_key,
        pc.product_category_key,

        b.report_date,
        b.report_year,
        b.report_quarter,
        b.report_month,

        b.value,
        b.unit,
        b.ingest_at

    from base b

    left join gold_gold.dim_time dt
        on b.report_date = dt.full_date

    left join gold_gold.dim_product_category pc
        on b.product_category_name = pc.product_category_name

    left join gold_gold.dim_product p
        on b.product_name = p.product_name

    where p.product_key is not null
      and pc.product_category_key is not null
      and dt.time_key is not null

),

joined_dedup as (

    select
        time_key,
        product_key,
        product_category_key,

        report_date,
        report_year,
        report_quarter,
        report_month,

        max(value) as value,
        max(unit) as unit,
        max(ingest_at) as ingest_at

    from joined

    group by
        time_key,
        product_key,
        product_category_key,
        report_date,
        report_year,
        report_quarter,
        report_month

),

with_prev as (

    select
        cur.time_key,
        cur.product_key,
        cur.product_category_key,

        cur.report_year,
        cur.report_quarter,
        cur.report_month,

        cur.value,
        cur.unit,

        prev_q.value as prev_quarter_value,
        prev_y.value as pre_year_value,

        cur.ingest_at

    from joined_dedup cur

    left join joined_dedup prev_q
        on cur.product_key = prev_q.product_key
       and cur.product_category_key = prev_q.product_category_key
       and (
            (
                cur.report_year = prev_q.report_year
                and cur.report_quarter = prev_q.report_quarter + 1
            )
            or
            (
                cur.report_year = prev_q.report_year + 1
                and cur.report_quarter = 1
                and prev_q.report_quarter = 4
            )
       )

    left join joined_dedup prev_y
        on cur.product_key = prev_y.product_key
       and cur.product_category_key = prev_y.product_category_key
       and cur.report_year = prev_y.report_year + 1
       and cur.report_quarter = prev_y.report_quarter

),

final as (

    select
        
    abs(xxhash64(coalesce(cast(time_key as string), '__null__'), coalesce(cast(product_key as string), '__null__'), coalesce(cast(product_category_key as string), '__null__')))
 as fact_production_key,

        time_key,
        product_key,
        product_category_key,

        cast(round(value, 3) as decimal(38,3)) as value,
        cast(unit as string) as unit,

        cast(round(prev_quarter_value, 3) as decimal(38,3)) as prev_quarter_value,
        cast(round(pre_year_value, 3) as decimal(38,3)) as pre_year_value,

        
    abs(xxhash64(coalesce(cast(time_key as string), '__null__'), coalesce(cast(product_key as string), '__null__'), coalesce(cast(product_category_key as string), '__null__')))
 as load_id,
        current_timestamp() as created_at,
        ingest_at

    from with_prev

)

select *
from final
    
