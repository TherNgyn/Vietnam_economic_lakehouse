[0m19:09:55.342968 [debug] [Thread-1 (]: On model.Vietnam_economic_lakehouse.dim_indicator_group: /* {"app": "dbt", "dbt_version": "1.12.0b3", "profile_name": "Vietnam_economic_lakehouse", "target_name": "spark", "node_id": "model.Vietnam_economic_lakehouse.dim_indicator_group"} */

        CREATE TABLE gold_gold.dim_indicator_group
        USING DELTA
        AS
        


select
    
    abs(xxhash64(coalesce(cast(indicator_group_name as string), '__null__')))
 as indicator_group_key,
    lower(trim(indicator_group_name)) as indicator_group_name
from (
    select distinct indicator_group_name
    from gold_staging.stg_macro_indicator
    where indicator_group_name is not null
)
    
