 as fact_agri_key,
    time_key,
    crop_key,
    source_key,
    production,
    area,
    
    abs(xxhash64(coalesce(cast(time_key as string), '__null__'), coalesce(cast(crop_key as string), '__null__'), coalesce(cast(source_key as string), '__null__')))
 as load_id,
