/* {"app": "dbt", "dbt_version": "1.12.0b3", "profile_name": "Vietnam_economic_lakehouse", "target_name": "spark", "node_id": "model.Vietnam_economic_lakehouse.fact_international_trade"} */

        CREATE TABLE gold_gold.fact_international_trade
        USING DELTA
        AS
        

with base as (

    select *
    from gold_staging.stg_trade_international

),

joined as (

    select
        t.time_key,
        p.product_key,

        b.year,
        b.quarter,
        b.month,

        cast(b.trade_value as decimal(38,10)) as trade_value,
        cast(b.quantity as decimal(38,10)) as quantity,

        b.value_unit,
        b.quantity_unit,

        b.ingest_at

    from base b

    
    left join gold_gold.dim_product_category pc
        on b.product_category_name = pc.product_category_name

    left join gold_gold.dim_product p
        on b.product_name = p.product_name
    and p.product_category_key = pc.product_category_key

    left join gold_gold.dim_time t
        on b.year = t.year
       and b.quarter = t.quarter
       and b.month = t.month

    where p.product_key is not null
      and t.time_key is not null

),

enriched as (

    select
        cur.time_key,
        cur.product_key,

        cur.year,
        cur.quarter,
        cur.month,

        cur.trade_value,
        cur.quantity,

        cur.value_unit,
        cur.quantity_unit,

        -- Semi-additive 
        prev_month.trade_value as trade_value_pre_month,
        prev_month.quantity as quantity_pre_month,

        -- Semi-additive cùng tháng năm trước
        prev_year.trade_value as trade_value_pre_year,
        prev_year.quantity as quantity_pre_year,

        cur.ingest_at

    from joined cur

    left join joined prev_year
        on cur.product_key = prev_year.product_key
       and cur.year = prev_year.year + 1
       and cur.month = prev_year.month

    left join joined prev_month
        on cur.product_key = prev_month.product_key
       and (
            (
                cur.year = prev_month.year
                and cur.month = prev_month.month + 1
            )
            or
            (
                cur.year = prev_month.year + 1
                and cur.month = 1
                and prev_month.month = 12
            )
       )

),

final as (

    select
        
    abs(xxhash64(coalesce(cast(time_key as string), '__null__'), coalesce(cast(product_key as string), '__null__')))
 as fact_trade_key,

        time_key,
        product_key,

        -- Additive measures
        cast(round(trade_value, 3) as decimal(38,3)) as trade_value,
        cast(round(quantity, 3) as decimal(38,3)) as quantity,

        value_unit,
        quantity_unit,

        -- Semi-additive / reference measures
        cast(round(trade_value_pre_month, 3) as decimal(38,3)) as trade_value_pre_month,
        cast(round(trade_value_pre_year, 3) as decimal(38,3)) as trade_value_pre_year,

        cast(round(quantity_pre_month, 3) as decimal(38,3)) as quantity_pre_month,
        cast(round(quantity_pre_year, 3) as decimal(38,3)) as quantity_pre_year,

        
    abs(xxhash64(coalesce(cast(time_key as string), '__null__'), coalesce(cast(product_key as string), '__null__')))
 as load_id,
        current_timestamp() as created_at,
        ingest_at

    from enriched

)

select *
from final
    
