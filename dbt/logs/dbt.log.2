        create or replace table gold_gold.dim_asset_class
      
      
    using delta
      
      
      
      
      
      

      as
      

with classes as (
    select distinct asset_class_name from gold_staging.stg_ohlc
    union
    select distinct asset_class_name from gold_staging.stg_interest_rate
)

select
    
