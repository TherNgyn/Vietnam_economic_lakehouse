/* {"app": "dbt", "dbt_version": "1.12.0b3", "profile_name": "Vietnam_economic_lakehouse", "target_name": "spark", "node_id": "model.Vietnam_economic_lakehouse.dim_time"} */

  
    
        create or replace table gold_gold.dim_time
      
      
    using delta
      
      
      
      
      
      

      as
      

with dates as (
    select distinct report_date from gold_staging.stg_macro_indicator
    union
    select distinct report_date from gold_staging.stg_ohlc
    union
    select distinct report_date from gold_staging.stg_interest_rate
    union
    select distinct report_date from gold_staging.stg_product_market
    union
    select distinct report_date from gold_staging.stg_agriculture
    union
    select distinct report_date from gold_staging.stg_gdp
    union
    select distinct report_date from gold_staging.stg_investment
    union
    select distinct report_date from gold_staging.stg_social_investment
),

final as (
    select
        cast(date_format(report_date, 'yyyyMMdd') as int) as time_key,
        report_date as full_date,
        day(report_date) as day,
        month(report_date) as month,
        quarter(report_date) as quarter,
        year(report_date) as year,
        cast(date_format(report_date, 'yyyyMM') as int) as year_month,
        concat(cast(year(report_date) as string), 'Q', cast(quarter(report_date) as string)) as year_quarter,
        case when report_date = last_day(report_date) then true else false end as is_month_end,
        case
            when month(report_date) in (3, 6, 9, 12)
             and report_date = last_day(report_date)
            then true else false
        end as is_quarter_end
    from dates
    where report_date is not null
)

select *
from final
  
