create or replace view gold_staging.stg_gdp
  
  
  as
    

select
    cast(concat(cast(`year` as string), '-', lpad(cast(case `quarter` when 1 then 1 when 2 then 4 when 3 then 7 when 4 then 10 else 1 end as string), 2, '0'), '-01') as date) as report_date,
