[0m19:12:01.564934 [debug] [Thread-1 (]: On model.Vietnam_economic_lakehouse.dim_sub_sector: /* {"app": "dbt", "dbt_version": "1.12.0b3", "profile_name": "Vietnam_economic_lakehouse", "target_name": "spark", "node_id": "model.Vietnam_economic_lakehouse.dim_sub_sector"} */

        CREATE TABLE gold_gold.dim_sub_sector
        USING DELTA
        AS
        

with sub_sectors as (
    select distinct sub_sector_name, sector_name
    from gold_staging.stg_gdp
    where sub_sector_name is not null
)

select
    
    abs(xxhash64(coalesce(cast(ss.sub_sector_name as string), '__null__')))
 as sub_sector_key,
    ss.sub_sector_name,
    s.sector_key
from sub_sectors ss
left join gold_gold.dim_sector s
    on ss.sector_name = s.sector_name
    
