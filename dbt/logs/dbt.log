create or replace view gold_staging.stg_interest_rate
  
  
  as
    

select
    cast(`date` as date) as date,
    symbol,
    cast(term as string) as term_name, 
    symbol as asset_name,
    'INTEREST_RATE' as asset_class_name,
    'MONEY_MARKET' as market_name,
    'VN' as country,
    cast(interest_rate as decimal(38,10)) as interest_rate,
    cast(volume as decimal(38,10)) as volume,
    '%' as unit_name, 
    cast(processing_date as timestamp) as ingest_at
from silver.interest_rate

[0m03:36:15.000974 [debug] [Thread-3 (]: On model.Vietnam_economic_lakehouse.stg_gdp: /* {"app": "dbt", "dbt_version": "1.12.0rc2", "profile_name": "Vietnam_economic_lakehouse", "target_name": "spark", "node_id": "model.Vietnam_economic_lakehouse.stg_gdp"} */
create or replace view gold_staging.stg_gdp
  
  
  as
    

select
    cast(concat(cast(`year` as string), '-', lpad(cast(case `quarter` when 1 then 1 when 2 then 4 when 3 then 7 when 4 then 10 else 1 end as string), 2, '0'), '-01') as date) as report_date,
