        CREATE TABLE gold_gold.dim_asset
        USING DELTA
        AS
        

with assets as (
    select distinct
        upper(trim(symbol)) as symbol,
        upper(trim(asset_name)) as asset_name,
        upper(trim(asset_class_name)) as asset_class_name,
        upper(trim(market_name)) as market_name,
