    union
    select distinct source_name from gold_staging.stg_social_investment
),

final as (
    select
        
    abs(xxhash64(coalesce(cast(source_name as string), '__null__')))
 as source_key,
        source_name,
        source_name as source_system
    from sources
    where source_name is not null
)

select *
